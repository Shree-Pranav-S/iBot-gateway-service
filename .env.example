APP_NAME=gateway-service
APP_ENV=development

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

CORE_API_URL=http://core-api-backend:8000
INTERVIEW_SERVICE_URL=http://interview-engine-backend:8001

GENERAL_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Cookie settings ──────────────────────────────────────────────────────────
# Set to true in GCP/Cloud Run (HTTPS required for Secure cookies).
# Leave false for local Docker development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ACCESS_MAX_AGE=3600
COOKIE_REFRESH_MAX_AGE=604800

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Wildcard "*" cannot be used with credentials=true.
# Add your Cloud Run frontend URL here for production.
CORS_ORIGINS=http://localhost:5173
